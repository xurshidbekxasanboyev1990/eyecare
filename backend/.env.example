# ==============================================================================
# EyeCare Backend - Environment Configuration
# ==============================================================================

# App Settings
APP_NAME=EyeCare
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eyecare
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/eyecare

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Telegram Bot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_WEBHOOK_URL=https://your-domain.com/bot/webhook
BOT_WEBHOOK_SECRET=your-webhook-secret

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=eyecare2026
ADMIN_EMAIL=admin@eyecare.uz

# SMS Provider (Eskiz.uz)
ESKIZ_EMAIL=your-eskiz-email
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_SENDER=EyeCare

# Storage (MinIO/S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=eyecare
STORAGE_USE_SSL=False

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://eyecare.uz"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
